extends "res://dev/review_river_valley.gd"
## Full fresh opening, expanded touch route, and stable legacy-progress reload.
func shot(id: String) -> void:
	DirAccess.make_dir_recursive_absolute("res://builds/playtest/valley-watershed")
	await frames(8)
	RenderingServer.force_draw(false)
	root.get_texture().get_image().save_png("res://builds/playtest/valley-watershed/"+id+".png")
func walk_point(at: Vector2) -> void:
	await walk_to(ValleyPlaces.point(at)+Vector3.UP*0.02)
func restore_near(id: String, disciplines: Array) -> void:
	# Reaches every place through touch movement. No teleporting the hero.
	var at: Vector2 = ValleyPlaces.POSITIONS[id]+Vector2(-2,0)
	await walk_point(at)
	for skill in disciplines:
		await select_skill(skill)
		await tap(center(region.get_node("TouchControls/RestoreButton")))
		await frames(32)
	await select_skill("mend")
	await touch(center(region.get_node("TouchControls/RestoreButton")),true)
	await frames(110)
	await touch(center(region.get_node("TouchControls/RestoreButton")),false)
	check(region.builder.entities[id].runtime.restored,"touch disciplines restore "+id)
func extra_route() -> void:
	await walk_point(Vector2(21.5,3.5))
	await walk_point(Vector2(29,3.5))
	await walk_point(Vector2(30,5.5))
	await tap(center(region.get_node("TouchControls/ContextButton")))
	await last_page()
	await control(region.story.dialogue._buttons[0])
	check(region.waykeeper.progress.unlocked.has("anchor"),"Iona teaches Anchor for the wider watershed")
	await control(region.story.dialogue._buttons[2])
	for point in ValleyPlaces.SOUTH_ROUTE.slice(0,3): await walk_point(point)
	await restore_near("B2",["anchor"])
	await shot("willow-refuge")
	for point in ValleyPlaces.SOUTH_ROUTE.slice(3,5): await walk_point(point)
	await tap(center(region.get_node("TouchControls/ContextButton")))
	check(region.story.dialogue.visible,"Oren is reachable at the authored boathouse")
	await shot("oren-dry-landing")
	await last_page()
	await control(region.story.dialogue._buttons[0])
	check(not paused and region.journal.pinned=="R1/C3","touch conversation remembers the upper weir")
	await restore_near("C2",["force"])
	await shot("reed-spring")
	for point in [Vector2(54,18),Vector2(39,2),Vector2(48,-10)]: await walk_point(point)
	await restore_near("B3",["force","anchor"])
	await shot("sunleaf-grove")
	await walk_point(Vector2(65,-9))
	await walk_point(Vector2(65,-25))
	await walk_point(Vector2(63,-25))
	await select_skill("mend")
	await touch(center(region.get_node("TouchControls/RestoreButton")),true)
	await frames(60)
	await touch(center(region.get_node("TouchControls/RestoreButton")),false)
	check(region.builder.entities.C3.runtime.progress>0 and not region.builder.entities.C3.runtime.restored,"touch Mend retains partial weir recovery")
	await shot("weir-partial")
	await restore_near("C3",["force","anchor"])
	await shot("weir-flow")
	await frames(160)
	check(region.builder.valley.banks.basin_water.visible,"water reaches the landing after the staged release")
	for point in [Vector2(61,-19),Vector2(58,-8),Vector2(56,7),Vector2(55,21),Vector2(56,35)]: await walk_point(point)
	await shot("landing-living")
	await tap(center(region.get_node("TouchControls/ContextButton")))
	check(region.story.dialogue.visible and region.story._talking=="oren","Oren can be touched at his new waterside work")
	check(region.story.dialogue._pages[0].contains("boat"),"Oren recognizes the returned water")
	await shot("oren-return")
	await control(region.story.dialogue._buttons[2])
	check(region.progression.xp==240,"all six stable places grant unique XP")
	var data: Dictionary = JSON.parse_string(JSON.stringify(region._journey_data()))
	region.free()
	region = load("res://scenes/levels/river_valley.tscn").instantiate()
	region.persist_progress = false
	root.add_child(region)
	current_scene = region
	region._apply_journey_data(data)
	region._configure_restoration()
	region._update_level_hud()
	region.opening.landscape.sync(false)
	await frames(20)
	check(region.progression.xp==240 and region.builder.valley.banks.water.visible,"completed expanded world reload preserves progress and water")
	check(region.inventory.equipped.tool=="grove_wand" and region.waykeeper.progress.purchased.has("steady_vessel"),"chosen build survives wider-world reload")
	await tap(center(region.get_node("JourneyHUD/MapButton")))
	await shot("watershed-map")
	await tap(region.journey_map.position+Vector2(389,20))
	print("Watershed touch failures: ",failures.size())
